[
  { "name": "keeps basic formatting", "input": "<p>Hello <b>bold</b> <i>it</i> <u>u</u> <s>s</s></p>", "contains": ["<p>", "<b>bold</b>", "<i>it</i>", "<u>u</u>", "<s>s</s>"], "notContains": [] },
  { "name": "keeps Chinese text", "input": "<p>中文測試，台灣用語</p>", "contains": ["中文測試，台灣用語"], "notContains": ["&#"] },
  { "name": "escapes ampersand", "input": "<p>A &amp; B</p>", "contains": ["A &amp; B"], "notContains": [] },
  { "name": "drops script with content", "input": "<p>ok</p><script>alert(1)</script>", "contains": ["<p>ok</p>"], "notContains": ["script", "alert"] },
  { "name": "drops style element", "input": "<style>body{display:none}</style><p>x</p>", "contains": ["<p>x</p>"], "notContains": ["style", "display"] },
  { "name": "drops iframe", "input": "<iframe src=\"https://evil.example\"></iframe><p>x</p>", "contains": ["<p>x</p>"], "notContains": ["iframe", "evil"] },
  { "name": "drops svg onload", "input": "<svg onload=\"alert(1)\"><circle/></svg><p>x</p>", "contains": ["<p>x</p>"], "notContains": ["svg", "onload", "alert"] },
  { "name": "removes event handlers", "input": "<img src=\"x.png\" onerror=\"alert(1)\"><p onclick=\"alert(2)\">t</p>", "contains": ["<img src=\"x.png\">", "<p>t</p>"], "notContains": ["onerror", "onclick", "alert"] },
  { "name": "blocks javascript: href", "input": "<a href=\"javascript:alert(1)\">x</a>", "contains": ["<a>x</a>"], "notContains": ["javascript"] },
  { "name": "blocks obfuscated javascript: href", "input": "<a href=\" JaVa&#x09;ScRiPt:alert(1)\">x</a>", "contains": ["x</a>"], "notContains": ["alert"] },
  { "name": "blocks vbscript: and data:text", "input": "<a href=\"vbscript:msgbox(1)\">a</a><a href=\"data:text/html,hi\">b</a>", "contains": ["<a>a</a>", "<a>b</a>"], "notContains": ["vbscript", "data:text"] },
  { "name": "keeps https / mailto / relative links", "input": "<a href=\"https://example.com/a?b=1\">1</a><a href=\"mailto:me@example.com\">2</a><a href=\"/path\">3</a><a href=\"page.html\">4</a>", "contains": ["href=\"https://example.com/a?b=1\"", "href=\"mailto:me@example.com\"", "href=\"/path\"", "href=\"page.html\""], "notContains": [] },
  { "name": "adds rel to target=_blank", "input": "<a href=\"https://example.com\" target=\"_blank\">x</a>", "contains": ["target=\"_blank\"", "rel=\"noopener noreferrer\""], "notContains": [] },
  { "name": "allows data:image src", "input": "<img src=\"data:image/png;base64,iVBORw0KGgo=\">", "contains": ["src=\"data:image/png;base64,iVBORw0KGgo=\""], "notContains": [] },
  { "name": "blocks data:text/html src", "input": "<img src=\"data:text/html;base64,PHNjcmlwdD4=\">", "contains": ["<img>"], "notContains": ["data:text"] },
  { "name": "filters style properties", "input": "<span style=\"color: red; position: fixed; background-image: url(x.png); font-size: 18px\">t</span>", "contains": ["color: red", "font-size: 18px"], "notContains": ["position", "url(", "background-image"] },
  { "name": "blocks expression() in style", "input": "<span style=\"color: expression(alert(1))\">t</span>", "contains": ["<span>t</span>"], "notContains": ["expression"] },
  { "name": "keeps only table classes", "input": "<table class=\"table table-bordered position-fixed w-100\"><tbody><tr><td colspan=\"2\" onmouseover=\"x()\">c</td></tr></tbody></table>", "contains": ["class=\"table table-bordered\"", "colspan=\"2\""], "notContains": ["position-fixed", "w-100", "onmouseover"] },
  { "name": "removes class on non-table tags", "input": "<p class=\"alert alert-danger\">x</p>", "contains": ["<p>x</p>"], "notContains": ["class"] },
  { "name": "unwraps unknown tags, keeps text", "input": "<p><o:p>word</o:p><custom-tag>keep</custom-tag></p>", "contains": ["word", "keep"], "notContains": ["o:p", "custom-tag"] },
  { "name": "drops form controls", "input": "<form action=\"https://evil.example\"><input name=\"password\"><button>Login</button></form><p>x</p>", "contains": ["<p>x</p>"], "notContains": ["form", "input", "button", "password"] },
  { "name": "removes HTML comments", "input": "<p>a<!-- secret -->b</p>", "contains": ["ab"], "notContains": ["secret", "<!--"] },
  { "name": "keeps lists, headings, blockquote, pre, hr", "input": "<h2>T</h2><ul><li>1</li></ul><ol><li>2</li></ol><blockquote>q</blockquote><pre>c</pre><hr>", "contains": ["<h2>T</h2>", "<ul><li>1</li></ul>", "<ol><li>2</li></ol>", "<blockquote>q</blockquote>", "<pre>c</pre>", "<hr>"], "notContains": [] },
  { "name": "keeps font color/size from execCommand", "input": "<font size=\"5\" color=\"#e03131\" face=\"Comic Sans\">big</font>", "contains": ["size=\"5\"", "color=\"#e03131\""], "notContains": ["face"] },
  { "name": "removes id and data attributes", "input": "<p id=\"x\" data-foo=\"bar\" title=\"t\">x</p>", "contains": ["<p>x</p>"], "notContains": ["id=", "data-foo", "title"] }
]
